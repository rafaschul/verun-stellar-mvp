## Verun Stellar MVP — environment

# Required: signer secret key (S...). The public address is derived from this.
# In single-account mode this is the only signer. When STELLAR_CHANNELS is set
# (recommended for production), this account is still required for funding
# bootstrap + acts as the legacy fallback if no channels are available.
STELLAR_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── High-throughput channel accounts (recommended for marketing) ────
# Generate via:  npm run channels 20    (creates + funds 20 channels)
# Then paste the printed comma-separated secrets here OR into Vercel env.
# Without this, anchor uses a single account and breaks above ~5 concurrent users.
# STELLAR_CHANNELS=SXXX...,SYYY...,SZZZ...,...

# Retry config (defaults handle 99% of collisions even with 1 channel)
# STELLAR_ANCHOR_MAX_RETRIES=4
# STELLAR_ANCHOR_BACKOFF_MS=250

# Public address of the signer. Optional — derived from STELLAR_SECRET if missing.
# If set, the app verifies it matches the secret on /api/config-check.
STELLAR_PUBLIC=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stellar Horizon endpoint (Testnet by default)
HORIZON_URL=https://horizon-testnet.stellar.org

# Network passphrase. Testnet = "Test SDF Network ; September 2015"
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Friendbot endpoint for auto-funding the testnet account on first call.
# Leave default unless you know what you're doing.
FRIENDBOT_URL=https://friendbot.stellar.org

# Local express port (only for `npm run api`, not Vercel)
PORT=3010

# ─── x402 Payment Layer (agent-native commerce) ─────────────────────
# Network kind for payment scheme selection: testnet | mainnet.
# Picks the matching USDC issuer (testnet GBBD47IF…VPTC / mainnet GA5ZSEJY…KZVN).
X402_NETWORK=testnet

# Per-evaluation price target in USD. USDC is 1:1 with USD; XLM amount is
# derived from the current market rate via CoinGecko (5-min cached).
X402_PRICE_USD=0.005

# Optional fixed overrides (skip market-rate conversion if set).
# X402_PRICE_USDC=0.005
# X402_PRICE_XLM=0.0125    # ← forces a fixed XLM amount, skips oracle

# Optional manual price overrides (skips oracle lookup, useful for tests).
# X402_PRICE_XLM_USD=0.40   # forces XLM = $0.40 assumption
# X402_PRICE_HBAR_USD=0.10  # forces HBAR = $0.10 assumption (if Hedera)
# PRICE_ORACLE_TTL_MS=300000  # cache TTL, default 5 min

# Stellar x402 Facilitator URL (when published — overrides default).
# Leave unset to use the simulate-mode demo terminal.
# X402_FACILITATOR_URL=https://x402.stellar.org

# Optional override for protocol payTo address. Defaults to STELLAR_PUBLIC.
# STELLAR_PAY_TO=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
